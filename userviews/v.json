                "userMenu": [],
                "urlsToCache": "",
                "loginPageTop": "<style>\n    /* Ensure the password field container has relative positioning */\n    .password-container {\n        position: absolute;\n        display: inline-block;\n        width: 15%;\n    }\n\n    /* Style for the eye icon inside the password field */\n    .toggle-password {\n        position: absolute;\n        right: 25px;\n        top: 50%;\n        transform: translateY(-50%);\n        cursor: pointer;\n        color: #666;\n        font-size: 18px;\n    }\n<\/style>\n\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        let passwordField = document.querySelector(\"input[type='password']\");\n\n        if (!passwordField) return; // Exit if no password field is found\n\n        // Ensure the password field's parent is positioned correctly\n        let parentDiv = passwordField.parentElement;\n        parentDiv.classList.add(\"password-container\");\n\n        // Create the eye icon inside a <span> to prevent button click issues\n        let toggleSpan = document.createElement(\"span\");\n        toggleSpan.innerHTML = '<i class=\"fas fa-eye\"><\/i>';\n        toggleSpan.classList.add(\"toggle-password\");\n\n        // Append the span inside the password field container\n        parentDiv.appendChild(toggleSpan);\n\n        // Toggle password visibility on click\n        toggleSpan.addEventListener(\"click\", function () {\n            let icon = toggleSpan.querySelector(\"i\");\n            if (passwordField.type === \"password\") {\n                passwordField.type = \"text\"; // Show password\n                icon.classList.replace(\"fa-eye\", \"fa-eye-slash\");\n            } else {\n                passwordField.type = \"password\"; // Hide password\n                icon.classList.replace(\"fa-eye-slash\", \"fa-eye\");\n            }\n        });\n    });\n<\/script>\n\n<!-- Include Font Awesome for the eye icon -->\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">",
